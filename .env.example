# Copy to .env. Never commit .env.
LEDGER_DATA=/volume2/ledger            # host directory holding postgres/ and brand/
POSTGRES_PASSWORD=change-me            # generate: openssl rand -hex 24
SESSION_SECRET=change-me               # generate: openssl rand -hex 32
BASE_URL=https://ledger.example.com    # public URL; OIDC redirect is ${BASE_URL}/auth/callback

# OIDC (Authentik: Applications → Providers → OAuth2/OpenID, confidential client, redirect URI above)
OIDC_ISSUER=https://auth.example.com/application/o/ledger/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
ALLOWED_GROUPS=admins                  # comma-separated; must appear in the `groups` claim; empty refuses to start
# EDITOR_GROUPS=admins                 # groups that may upload, rebuild, edit settings and generate reviews; others admitted by ALLOWED_GROUPS only view. Default: ALLOWED_GROUPS
# SESSION_MAX_AGE=43200                # seconds a sign-in lasts, counted from sign-in (default 12 h)
# GROUP_RECHECK_SECONDS=300            # groups are re-read from the IdP this often; a removed member is out within it

# Content-Security-Policy: extra sources a BRAND_DIR theme needs (space-separated). Defaults allow Google Fonts;
# set both empty for a theme with self-hosted fonts.
# CSP_STYLE_SRC=https://fonts.googleapis.com
# CSP_FONT_SRC=https://fonts.gstatic.com
# CSP_IMG_SRC=

# Month-close review (optional; the Generate button is disabled until a provider is configured)
ANTHROPIC_API_KEY=
REVIEW_MODEL=claude-sonnet-5-5
# Other providers: REVIEW_PROVIDER=openai|ollama|gemini; these need REVIEW_MODEL (no default). Provider/model/base URL can also be
# picked on the Reviews page. Local models may need a larger REVIEW_MAX_TOKENS.
#REVIEW_PROVIDER=anthropic
#REVIEW_BASE_URL=                      # openai: https://api.example.com/v1   ollama: http://ollama:11434
#REVIEW_API_KEY=                       # openai-compatible (optional for local servers) and gemini
#REVIEW_MAX_TOKENS=2500

# Local development only — never set in production
# AUTH_DISABLED=true
# Optional backups (docker compose --profile backup up -d): dumps go to ${LEDGER_DATA}/backups
# BACKUP_KEEP_DAYS=14
# BACKUP_INTERVAL_HOURS=24
# I_KNOW_AUTH_IS_OFF=1   # required to run AUTH_DISABLED=true when BASE_URL is not localhost
